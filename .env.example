# A2 Enterprise Knowledge Base : example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored). Every var
# below is consumed by config/settings.yaml via ${VAR:-default} interpolation. The
# local/test profile needs NONE of the GCP-specific values : only KB_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.
#   local  : a WORKING offline laptop stack (SQLite FTS5 + deterministic LLM), SDK-free,
#            no API key, no emulator required. The dev / test default; runs end to end.
#   gcp    : Google Cloud managed services (production).
#   onprem : fail-fast Google Distributed Cloud migration placeholders (exit 2 on use).
KB_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Local profile stores (SDK-free). Unset => per-package defaults under ~/.enterprise_kb/.
# ---------------------------------------------------------------------------
# KB_LOCAL_DB=/path/to/local.db
# KB_LOCAL_AUDIT=/path/to/audit.db
# KB_LOCAL_LEDGER=/path/to/ledger.db

# Optional: higher-fidelity local runs route to Google's official emulators when these
# standard env vars are set AND the [gcp] client libs are installed (the google client is
# imported lazily, only on that branch). Leave unset for the default SDK-free local path.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# PUBSUB_EMULATOR_HOST=localhost:8085
# STORAGE_EMULATOR_HOST=localhost:9023

# Runtime region is one reviewed input and every regional endpoint derives from it. The shipped
# Singapore reference Terraform module refuses another value; portable core/adapters remain
# region-parametric. Configured-empty refuses rather than silently choosing a default.
# KB_REGION=asia-southeast1

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
# KB_KMS_KEY=projects/PROJECT/locations/asia-southeast1/keyRings/RING/cryptoKeys/KEY

# Toggle public-web grounding (the google_search sub-agent). true | false. Default off.
KB_GROUNDING_ENABLED=false

# ---------------------------------------------------------------------------
# Retrieval / ingest (gcp profile)
# ---------------------------------------------------------------------------
# Regional Terraform-created Model Armor template id.
# KB_MODEL_ARMOR_TEMPLATE=enterprise-knowledge-base-guardrail
# Managed refresh control artifacts are in a publisher-owned bucket the pipeline can only read.
# KB_CONTROL_BUCKET=enterprise-knowledge-base-control-PROJECT_ID
# KB_CORPUS_REGISTRY=gs://enterprise-knowledge-base-control-PROJECT_ID/registry/registry.yaml
# KB_ACL_BINDINGS_URI=gs://enterprise-knowledge-base-control-PROJECT_ID/acl/bindings.json

# Raw source documents are isolated in a second regional bucket; pipeline has viewer only.
# Registry document URIs must be gs://enterprise-knowledge-base-raw-PROJECT_ID/sources/...
# KB_RAW_SOURCE_BUCKET=enterprise-knowledge-base-raw-PROJECT_ID

# Single-region, CMEK-encrypted corpus bucket holding the redacted documents.
# Terraform project-derived, globally unique regional bucket name.
KB_CORPUS_BUCKET=enterprise-knowledge-base-corpus-PROJECT_ID

# ---------------------------------------------------------------------------
# Freshness / vector store : AlloyDB (gcp profile)
# ---------------------------------------------------------------------------
# Full instance URI: projects/.../locations/asia-southeast1/clusters/.../instances/...
# KB_ALLOYDB_URI=projects/PROJECT/locations/asia-southeast1/clusters/CLUSTER/instances/INSTANCE
# Workload-specific IAM database username from Terraform output `alloydb_iam_database_users`.
# Use app or pipeline for the matching active service account; configured-empty refuses.
# KB_ALLOYDB_USER=enterprise-knowledge-base-app@PROJECT_ID.iam

# Jurisdictions whose national-identifier patterns are masked, as ISO-3166 alpha-2 codes
# (comma-separated). Selects rows from the shared pii-kit, and the SAME selection drives
# the local regex redactor, the DLP custom info types and the eval pii_safety metric, so
# a market change cannot leave the gate green while the redactor stops masking.
# Supported: SG, HK, JP, AU, IN, GB. Default: SG.
KB_PII_JURISDICTIONS=SG

# ---------------------------------------------------------------------------
# Agent Runtime (optional code seam only; no managed identity or deployment authority exists)
# ---------------------------------------------------------------------------
# KB_AGENT_ENGINE is intentionally unset in the supported API/UI/pipeline deployment.

# Managed browser/S2S identity values are injected by Terraform. Browser IAP needs no app bearer.
# An S2S caller uses IAP Proxy-Authorization plus app Authorization and must have an exact mapping.
# KB_IAP_SERVICE_TENANTS={"journey@PROJECT_ID.iam.gserviceaccount.com":"bank.example"}

# ---------------------------------------------------------------------------
# Sibling platform services (platform profile : remote clients to A1/A3/A5)
# ---------------------------------------------------------------------------
HRZ_GUARDRAIL_URL=http://localhost:8080
HRZ_REGISTRY_URL=http://localhost:8083
HRZ_OBSERVABILITY_URL=http://localhost:8085

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# KB_SETTINGS=config/settings.yaml
